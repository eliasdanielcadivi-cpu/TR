# AgenteDeCambio CLI - Variables de Entorno

# Copiar este archivo a .env y configurar tus credenciales

# DeepSeek API Key (requerida para streaming)
# Obtener en: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-tu-api-key-aqui

# Umbral de deriva delta (opcional, default: 0.3)
PROMPT_DELTA_THRESHOLD=0.3

# Modelo de DeepSeek (opcional, default: deepseek-chat)
DEEPSEEK_MODEL=deepseek-chat

# Temperatura (opcional, default: 0.7)
DEEPSEEK_TEMPERATURE=0.7

# Máximo de tokens (opcional, default: 4096)
DEEPSEEK_MAX_TOKENS=4096
