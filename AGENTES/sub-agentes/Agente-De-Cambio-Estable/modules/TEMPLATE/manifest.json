{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "@agentedecambio2/[nombre-modulo]",
  "version": "0.1.0",
  "name": "[Nombre Legible del Módulo]",
  "description": "[Descripción de 1-2 líneas del propósito del módulo]",
  "author": "AgenteDeCambio2 Team",
  "license": "MIT",
  "type": "module",
  "actions": [
    {
      "name": "[nombreFuncion1]",
      "description": "[Qué hace esta función]",
      "parameters": {
        "type": "object",
        "properties": {
          "param1": {
            "type": "string",
            "description": "[Descripción del parámetro]"
          }
        },
        "required": ["param1"]
      },
      "returns": {
        "type": "object",
        "description": "[Qué devuelve]"
      },
      "throws": ["[Cuándo lanza error]"],
      "sideEffects": false,
      "aiSafe": true
    }
  ],
  "events": {
    "emits": [
      {
        "name": "[nombre-evento]",
        "description": "[Cuándo se emite]",
        "payload": {
          "type": "object",
          "properties": {}
        }
      }
    ],
    "subscribes": [
      {
        "name": "[nombre-evento]",
        "description": "[Para qué se suscribe]",
        "handler": "[nombreFuncionHandler]"
      }
    ]
  },
  "dependencies": [
    {
      "moduleId": "@agentedecambio2/[nombre-modulo-depenedencia]",
      "version": ">=0.1.0",
      "reason": "[Por qué depende de este módulo]"
    }
  ],
  "exports": {
    ".": {
      "types": "./types.ts",
      "import": "./actions.ts"
    },
    "./actions": {
      "types": "./actions.ts",
      "import": "./actions.ts"
    },
    "./types": {
      "types": "./types.ts",
      "import": "./types.ts"
    }
  },
  "keywords": [
    "agentedecambio2",
    "[palabra-clave-1]",
    "[palabra-clave-2]"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/usuario/AgenteDeCambio2.git",
    "directory": "modules/[nombre-modulo]"
  }
}
